---
import Layout from '@/layouts/Layout.astro';
import { getAllPosts } from '@/lib/sanity';

const posts = await getAllPosts();

const allTags = [...new Set(posts.flatMap(p => p.tags ?? []))];
const tagCounts = allTags.reduce<Record<string, number>>((acc, tag) => {
  acc[tag] = posts.filter(p => p.tags?.includes(tag) ?? false).length;
  return acc;
}, {});

const formatDate = (iso: string) =>
  new Date(iso).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Layout
  title="Actualités & Communiqués — LSPD"
  description="Retrouvez l'ensemble des communiqués officiels, avis au public et points de presse du Los Santos Police Department."
>

  <!-- ═══════════════════════════ EN-TÊTE DE PAGE ══════════════════════════ -->
  <section class="bg-lspd-navy-deep relative overflow-hidden py-14 md:py-16">
    <div
      class="absolute inset-0 opacity-[0.035]"
      style="background-image: repeating-linear-gradient(45deg, #c9a961 0, #c9a961 1px, transparent 0, transparent 22px); background-size: 22px 22px;"
    ></div>
    <div class="absolute bottom-0 left-0 right-0 h-px bg-lspd-gold/20"></div>

    <div class="relative max-w-7xl mx-auto px-6 lg:px-8">
      <nav aria-label="Fil d'Ariane" class="flex items-center gap-2 mb-6">
        <a href="/" class="text-[10px] font-mono tracking-[0.3em] uppercase text-white/35 hover:text-white/60 transition-colors">
          Accueil
        </a>
        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-white/25 shrink-0">
          <path d="M9 18l6-6-6-6"/>
        </svg>
        <span class="text-[10px] font-mono tracking-[0.3em] uppercase text-lspd-gold/70">
          Actualités
        </span>
      </nav>

      <p class="text-lspd-gold text-[10px] font-mono tracking-[0.45em] uppercase mb-3 opacity-70">
        Communications officielles
      </p>
      <h1 class="font-display font-semibold text-white leading-tight mb-4" style="font-size: clamp(2rem, 5vw, 3rem);">
        Actualités &amp; Communiqués
      </h1>
      <div class="flex items-center gap-4">
        <div class="w-12 h-px bg-lspd-gold/40"></div>
        <p class="font-display italic text-white/40 text-base">
          Los Santos Police Department
        </p>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════ FILTRE + ARTICLES ════════════════════════ -->
  <section class="bg-bg py-14 md:py-20">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">

      <!-- Filtres -->
      {allTags.length > 0 && (
        <div
          class="flex overflow-x-auto gap-2 mb-12 pb-0.5 -mx-6 px-6 lg:mx-0 lg:px-0 lg:flex-wrap"
          role="group"
          aria-label="Filtrer par mot-clé"
          style="scrollbar-width: none;"
        >
          <button
            data-filter="all"
            aria-pressed="true"
            class="filter-btn shrink-0 inline-flex items-center gap-2 px-4 py-2 border border-lspd-gold/60 bg-lspd-navy text-white text-[10px] font-mono tracking-[0.25em] uppercase transition-colors duration-200"
            style="border-radius: var(--radius-sm)"
          >
            Tous
            <span class="text-lspd-gold/70">{posts.length}</span>
          </button>
          {allTags.map(tag => (
            <button
              data-filter={tag}
              aria-pressed="false"
              class="filter-btn shrink-0 inline-flex items-center gap-2 px-4 py-2 border border-border text-text-muted hover:border-lspd-gold/40 hover:text-text text-[10px] font-mono tracking-[0.25em] uppercase transition-colors duration-200"
              style="border-radius: var(--radius-sm)"
            >
              {tag}
              <span class="text-text-subtle">{tagCounts[tag]}</span>
            </button>
          ))}
        </div>
      )}

      <!-- Grille d'articles -->
      <div id="articles-grid" class="grid md:grid-cols-2 gap-4" data-anim="stagger">
        {posts.map(post => (
          <article
            data-tags={post.tags?.join(',') ?? ''}
            class="news-card relative bg-surface border border-border group hover:border-lspd-gold/35 transition-colors duration-300 flex flex-row overflow-hidden"
          >
            <!-- Image gauche -->
            <div class="shrink-0 w-44 relative overflow-hidden border-r border-border">
              {post.coverImage?.url ? (
                <img
                  src={`${post.coverImage.url}?w=400&auto=format`}
                  alt={post.coverImage.alt ?? post.title}
                  loading="lazy"
                  class="absolute inset-0 w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-500"
                />
              ) : (
                <div class="absolute inset-0 bg-lspd-navy/5 flex items-center justify-center">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-border">
                    <rect x="3" y="3" width="18" height="18" rx="1"/><path d="m3 9 4-4 4 4 4-6 4 6"/>
                  </svg>
                </div>
              )}
            </div>

            <!-- Contenu droite -->
            <div class="flex flex-col flex-1 min-w-0">
              <div class="flex items-center justify-between px-4 py-2.5 border-b border-border bg-bg/60">
                <span class="text-[9px] font-mono tracking-widest uppercase text-text-muted truncate">
                  {post.tags?.[0] ?? 'Communiqué'}
                </span>
                <time datetime={post.publishedAt} class="text-[9px] font-mono text-text-subtle shrink-0 ml-2">
                  {formatDate(post.publishedAt)}
                </time>
              </div>

              <div class="p-4 flex flex-col flex-1">
                <h2 class="font-display text-base font-semibold text-text leading-snug mb-2 line-clamp-3">
                  {post.title}
                </h2>
                <p class="text-text-muted text-xs leading-relaxed flex-1 mb-4 line-clamp-3">
                  {post.excerpt}
                </p>

                <div class="border-t border-border pt-3">
                  <a
                    href={`/actualites/${post.slug.current}`}
                    class="inline-flex items-center gap-1.5 text-[9px] font-mono tracking-widest uppercase text-text-subtle hover:text-lspd-navy transition-colors group/lnk"
                  >
                    Consulter
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="group-hover/lnk:translate-x-0.5 transition-transform">
                      <path d="M5 12h14M12 5l7 7-7 7"/>
                    </svg>
                  </a>
                </div>
              </div>
            </div>

            <!-- Barre dorée bas -->
            <div class="absolute bottom-0 left-0 right-0 h-px bg-lspd-gold origin-left scale-x-0 group-hover:scale-x-100 transition-transform duration-300"></div>
          </article>
        ))}
      </div>

      <!-- État vide -->
      <div id="empty-state" class={posts.length === 0 ? 'py-20 text-center' : 'hidden py-20 text-center'}>
        <div class="w-10 h-10 border border-border flex items-center justify-center mx-auto mb-5" style="border-radius: var(--radius-sm)">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-text-subtle">
            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
          </svg>
        </div>
        <p class="font-display text-xl text-text-muted">Aucun communiqué dans cette catégorie.</p>
        <button
          data-filter="all"
          class="filter-btn mt-5 text-[10px] font-mono tracking-widest uppercase text-lspd-gold hover:text-lspd-gold-bright transition-colors"
        >
          Afficher tous les communiqués
        </button>
      </div>

    </div>
  </section>

</Layout>

<script>
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('.news-card');
  const emptyState = document.getElementById('empty-state');

  function applyFilter(filter: string): void {
    filterBtns.forEach(b => {
      const isActive = b.dataset.filter === filter;
      b.setAttribute('aria-pressed', String(isActive));
      if (isActive) {
        b.classList.add('border-lspd-gold/60', 'bg-lspd-navy', 'text-white');
        b.classList.remove('border-border', 'text-text-muted', 'hover:text-text', 'hover:border-lspd-gold/40');
      } else {
        b.classList.remove('border-lspd-gold/60', 'bg-lspd-navy', 'text-white');
        b.classList.add('border-border', 'text-text-muted', 'hover:text-text', 'hover:border-lspd-gold/40');
      }
    });

    let visible = 0;
    cards.forEach(card => {
      const tags = card.dataset.tags?.split(',').filter(Boolean) ?? [];
      const matches = filter === 'all' || tags.includes(filter);
      card.style.display = matches ? '' : 'none';
      if (matches) visible++;
    });

    if (emptyState) {
      emptyState.classList.toggle('hidden', visible > 0);
    }
  }

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      applyFilter(btn.dataset.filter ?? 'all');
    });
  });
</script>
