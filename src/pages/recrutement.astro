<script>
  const radios = document.querySelectorAll<HTMLInputElement>('[name="experience"]');
  const detailsEl = document.getElementById('experience-details');

  function syncDetails() {
    const checked = document.querySelector<HTMLInputElement>('[name="experience"]:checked');
    if (detailsEl) {
      detailsEl.hidden = checked?.value !== 'oui';
    }
  }

  radios.forEach(radio => radio.addEventListener('change', syncDetails));
  syncDetails();

  /* Radio visuel : synchronisation du pseudo-élément cercle */
  radios.forEach(radio => {
    radio.addEventListener('change', () => {
      radios.forEach(r => {
        const dot = r.nextElementSibling?.querySelector('span');
        if (dot) dot.style.opacity = r.checked ? '1' : '0';
      });
    });
  });

  /* Compteur de caractères : `maxlength` borne la saisie sur la limite d'un
     champ d'embed Discord, le compteur rend cette limite visible au candidat. */
  const zonesLibres = document.querySelectorAll<HTMLTextAreaElement>('textarea[data-compteur]');

  zonesLibres.forEach(zone => {
    const compteur = document.querySelector<HTMLElement>(`[data-compteur-pour="${zone.id}"]`);
    if (!compteur) return;

    const max = zone.maxLength;
    const sync = () => {
      const saisis = zone.value.length;
      compteur.textContent = `${saisis} / ${max}`;
      compteur.classList.toggle('text-warning', saisis >= max);
      compteur.classList.toggle('text-text-subtle', saisis < max);
    };

    zone.addEventListener('input', sync);
    sync();
  });

  /* Après soumission, la page est rechargée en haut : on amène le candidat
     sur le compte rendu — accusé de réception, erreur de transmission, ou
     à défaut le premier champ rejeté par la validation. */
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const compteRendu =
    document.getElementById('candidature-confirmation') ??
    document.getElementById('candidature-erreur');

  /* Les champs en erreur sont les seuls à décrire un message `<champ>-error`. */
  const premierChampRejete = document.querySelector<HTMLElement>(
    '[aria-describedby$="-error"]'
  );

  const cible = compteRendu ?? premierChampRejete;

  if (cible) {
    cible.scrollIntoView({
      behavior: reduceMotion ? 'auto' : 'smooth',
      block: 'center',
    });
    /* Un champ masqué (section conditionnelle repliée) n'est pas focusable :
       le défilement seul suffit alors. */
    if (cible.offsetParent !== null || cible === compteRendu) {
      cible.focus({ preventScroll: true });
    }
  }
</script>
