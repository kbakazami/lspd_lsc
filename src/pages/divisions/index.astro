---
import Layout from '@/layouts/Layout.astro';
import { getAllDivisions } from '@/lib/sanity';

const divisions = await getAllDivisions();
---

<Layout
  title="Divisions — LSPD"
  description="Unités spécialisées du Los Santos Police Department : Bureau des Détectives, Unité Tactique, Support Aérien et Patrouille Autoroutière."
>

  <!-- ═══════════════════════════ EN-TÊTE ══════════════════════════════════ -->
  <section class="bg-lspd-navy-deep border-b border-lspd-gold/20 py-16">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">

      <nav class="flex items-center gap-2 mb-10" aria-label="Fil d'Ariane">
        <a href="/" class="text-[10px] font-mono tracking-widest uppercase text-white/35 hover:text-white/65 transition-colors">Accueil</a>
        <span class="text-white/20 text-[10px] mx-1">›</span>
        <span class="text-[10px] font-mono tracking-widest uppercase text-lspd-gold/75">Divisions</span>
      </nav>

      <div class="flex items-start gap-8">
        <div class="shrink-0 hidden sm:flex w-14 h-14 border border-lspd-gold/30 items-center justify-center" style="border-radius: var(--radius-sm)">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#c9a961" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="7" width="20" height="14" rx="2"/>
            <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
          </svg>
        </div>
        <div>
          <p class="text-lspd-gold text-[10px] font-mono tracking-[0.35em] uppercase mb-3 opacity-70">
            Organisation interne
          </p>
          <h1 class="font-display font-semibold text-white leading-none" style="font-size: clamp(2rem, 5vw, 3.5rem);">
            Divisions du Département
          </h1>
          <p class="mt-4 text-white/45 text-sm max-w-2xl leading-relaxed">
            Le Los Santos Police Department s'appuie sur des unités spécialisées pour répondre à l'ensemble
            des situations rencontrées sur le terrain. Chaque division dispose de missions, de moyens et d'un
            encadrement propres à son domaine d'intervention.
          </p>
        </div>
      </div>

    </div>
  </section>

  <!-- ═══════════════════════════ LISTE ════════════════════════════════════ -->
  <section class="bg-bg py-20">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">

      {divisions.length === 0 ? (
        <div class="text-center py-20">
          <p class="text-text-muted text-sm font-mono">Aucune division enregistrée pour le moment.</p>
        </div>
      ) : (
        <>
          <div class="mb-10">
            <p class="text-lspd-gold text-[10px] font-mono tracking-[0.3em] uppercase mb-2">Unités actives</p>
            <h2 class="font-display text-3xl font-semibold text-text">
              {divisions.length} division{divisions.length > 1 ? 's' : ''} opérationnelle{divisions.length > 1 ? 's' : ''}
            </h2>
            <div class="mt-3 w-12 h-px bg-lspd-gold"></div>
          </div>

          <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
            {divisions.map(div => (
              <a
                href={`/divisions/${div.slug.current}`}
                class="border border-border group hover:border-lspd-gold/40 transition-all duration-300 flex flex-col overflow-hidden"
                style="border-radius: var(--radius-md)"
              >
                <!-- Image ou fallback navy -->
                <div class="relative h-44 shrink-0 overflow-hidden">
                  {div.coverImage?.url ? (
                    <img
                      src={`${div.coverImage.url}?w=480&auto=format`}
                      alt=""
                      aria-hidden="true"
                      loading="lazy"
                      class="w-full h-full object-contain bg-lspd-navy group-hover:scale-[1.03] transition-transform duration-500"
                    />
                  ) : (
                    <div class="w-full h-full bg-lspd-navy flex items-center justify-center">
                      <div class="absolute inset-0 opacity-[0.04]" style="background-image: repeating-linear-gradient(45deg, #c9a961 0, #c9a961 1px, transparent 0, transparent 22px); background-size: 22px 22px;"></div>
                      <span class="relative font-display text-4xl font-semibold text-lspd-gold/15 tracking-widest select-none">{div.abbreviation}</span>
                    </div>
                  )}
                  <div class="absolute inset-0 bg-gradient-to-t from-lspd-navy/40 to-transparent pointer-events-none"></div>
                </div>
                <!-- Contenu sur fond solide -->
                <div class="p-6 flex flex-col flex-1 bg-surface">
                  <div
                    class="inline-flex items-center self-start px-2 h-7 border border-lspd-gold/30 mb-4 group-hover:border-lspd-gold/60 transition-colors shrink-0"
                    style="border-radius: var(--radius-sm)"
                  >
                    <span class="text-lspd-gold font-mono text-[10px] font-semibold tracking-wide whitespace-nowrap">{div.abbreviation}</span>
                  </div>
                  <h3 class="font-display text-lg font-semibold text-text leading-snug mb-2">{div.name}</h3>
                  <p class="text-text-muted text-sm leading-relaxed flex-1 mb-5">{div.excerpt}</p>
                  <!-- Métadonnées en bas -->
                  <div class="pt-4 border-t border-border flex flex-wrap gap-x-4 gap-y-2">
                    {div.lead && (
                      <div class="flex items-center gap-1.5">
                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-lspd-gold/50 shrink-0">
                          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
                        </svg>
                        <span class="text-[10px] font-mono text-text-subtle">{div.lead.rank} {div.lead.name}</span>
                      </div>
                    )}
                    <div class="flex items-center gap-1.5">
                      <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-lspd-gold/50 shrink-0">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>
                      </svg>
                      <span class="text-[10px] font-mono text-text-subtle">{div.memberCount} membre{div.memberCount > 1 ? 's' : ''}</span>
                    </div>
                    {div.minRankLevel && (
                      <div class="flex items-center gap-1.5">
                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-lspd-gold/50 shrink-0">
                          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                        </svg>
                        <span class="text-[10px] font-mono text-text-subtle">Niv. {div.minRankLevel} min.</span>
                      </div>
                    )}
                  </div>
                </div>
                <!-- Barre dorée au survol -->
                <div class="h-0.5 bg-lspd-gold origin-left scale-x-0 group-hover:scale-x-100 transition-transform duration-300 shrink-0"></div>
              </a>
            ))}
          </div>
        </>
      )}

    </div>
  </section>

  <!-- ═══════════════════════════ CTA ══════════════════════════════════════ -->
  <section class="bg-lspd-navy py-16 relative overflow-hidden">
    <div
      class="absolute inset-0 opacity-[0.025]"
      style="background-image: repeating-linear-gradient(0deg, #c9a961 0, #c9a961 1px, transparent 0, transparent 44px), repeating-linear-gradient(90deg, #c9a961 0, #c9a961 1px, transparent 0, transparent 44px);"
    ></div>
    <div class="relative max-w-3xl mx-auto px-6 lg:px-8 text-center">
      <p class="text-lspd-gold text-[10px] font-mono tracking-[0.35em] uppercase mb-6 opacity-75">
        Intégrer le département
      </p>
      <h2 class="font-display font-semibold text-white mb-4" style="font-size: clamp(1.6rem, 4vw, 2.4rem);">
        Vous souhaitez rejoindre nos rangs ?
      </h2>
      <p class="text-white/45 text-sm leading-relaxed mb-8 max-w-lg mx-auto">
        Toute candidature est examinée par le Bureau des Ressources Humaines. Les dossiers sont ouverts
        aux citoyens remplissant les conditions requises.
      </p>
      <a
        href="/recrutement"
        class="inline-flex items-center justify-center px-9 py-4 bg-lspd-gold text-lspd-navy text-xs font-semibold tracking-[0.2em] uppercase hover:bg-lspd-gold-bright transition-colors duration-200"
        style="border-radius: var(--radius-sm)"
      >
        Déposer ma candidature
      </a>
    </div>
  </section>

</Layout>
