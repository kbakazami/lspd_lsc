---
const year = new Date().getFullYear();

const deptLinks = [
  { label: 'Actualités', href: '/actualites' },
  { label: 'Organigramme', href: '/organigramme' },
  { label: 'Divisions', href: '/divisions' },
  { label: 'Recrutement', href: '/recrutement' },
];

const citizenLinks = [
  { label: 'Informations OOC', href: '/oc-info' },
];
---

<footer class="bg-lspd-navy-deep">
  <div class="max-w-7xl mx-auto px-6 lg:px-8 pt-16 pb-10">

    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 mb-12">

      <!-- Brand -->
      <div class="md:col-span-2">
        <div class="flex items-center gap-3 mb-5">
          <img
            src="/lspd-seal.webp"
            alt="LSPD Seal"
            width="36"
            height="36"
            class="w-9 h-9 shrink-0 object-contain"
          />
          <div>
            <span class="block text-[10px] text-lspd-gold font-mono tracking-[0.28em] uppercase opacity-70">Los Santos</span>
            <span class="block text-white font-display text-lg font-semibold tracking-wide">Police Department</span>
          </div>
        </div>
        <p class="font-display italic text-white/40 text-sm leading-relaxed max-w-xs">
          « Protéger et servir la population de Los Santos avec honneur, intégrité et professionnalisme. »
        </p>
      </div>

      <!-- Département -->
      <div>
        <h4 class="text-lspd-gold text-[10px] font-mono tracking-[0.3em] uppercase mb-5">Département</h4>
        <ul class="space-y-2.5">
          {deptLinks.map(link => (
            <li>
              <a href={link.href} class="text-white/45 text-sm hover:text-white/75 transition-colors duration-150">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Citoyens -->
      <div>
        <h4 class="text-lspd-gold text-[10px] font-mono tracking-[0.3em] uppercase mb-5">Citoyens</h4>
        <ul class="space-y-2.5">
          {citizenLinks.map(link => (
            <li>
              <a href={link.href} class="text-white/45 text-sm hover:text-white/75 transition-colors duration-150">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="border-t border-white/10 pt-8 flex flex-col md:flex-row justify-between items-start md:items-center gap-3">
      <p class="text-white/25 text-xs font-mono">
        © {year} Los Santos Police Department — Faction RP LSC. Contenu fictif.
      </p>
      <p class="text-white/15 text-xs font-mono">
        Site in-character — usage roleplay uniquement
      </p>
    </div>
  </div>
</footer>
